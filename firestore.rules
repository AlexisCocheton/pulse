rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== PROFILES ======
    // Tout utilisateur connecté peut lire (découverte)
    // Seul le propriétaire peut modifier/supprimer son profil
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ====== INTERACTIONS ======
    // Format ID : fromUserId-toUserId
    match /interactions/{interactionId} {
      // Lecture : être l'émetteur ou le destinataire
      allow read: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      // Création : fromUserId doit être l'utilisateur connecté
      allow create: if request.auth != null &&
        request.resource.data.fromUserId == request.auth.uid;
      // Mise à jour : être l'émetteur
      allow update: if request.auth != null &&
        resource.data.fromUserId == request.auth.uid;
      // Suppression : être impliqué (unmatch efface les deux sens)
      allow delete: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // ====== MATCHES ======
    // Format ID : sorted(userId1-userId2)
    match /matches/{matchId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.users;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.users;
      allow delete: if request.auth != null &&
        request.auth.uid in resource.data.users;
    }

    // ====== CONVERSATIONS ======
    // Format ID : sorted(userId1-userId2)
    match /conversations/{convId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.users;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.users;
      allow delete: if false;

      // ====== MESSAGES (sous-collection) ======
      match /messages/{messageId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.users;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.users &&
          request.resource.data.senderId == request.auth.uid;
        // Les messages ne sont ni modifiables ni supprimables
        allow update, delete: if false;
      }
    }

    // ====== REPORTS ======
    // Création uniquement, par l'utilisateur connecté
    // Lecture réservée à l'admin via Admin SDK (moderation_screen utilise des données simulées)
    match /reports/{reportId} {
      allow create: if request.auth != null &&
        request.resource.data.fromUserId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
